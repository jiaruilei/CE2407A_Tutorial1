# Set the real key only in Render's environment settings or a local ignored .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_TIMEOUT_MS=55000
PORT=3000

# Shared-IP allowance supports a classroom behind one campus network.
CHAT_REQUESTS_PER_MINUTE=120
CHAT_CONCURRENCY_LIMIT=8
# In-memory limits reset on restart; use the API project's budget controls too.
CHAT_DAILY_LIMIT=2000

# Render supplies RENDER_EXTERNAL_URL and RENDER automatically.
# For another reverse proxy, set these explicitly to its public origin.
# PUBLIC_ORIGIN=https://example.com
# TRUST_PROXY=true
